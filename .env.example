# ══════════════════════════════════════════════════════════════════
# LeanStock — Environment Variables Template
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════

# ── Database (use service names when running via docker-compose) ───
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/leanstock
POSTGRES_DB=leanstock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Gmail SMTP) ────────────────────────────────────────────
# Enable 2FA → create App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_gmail@gmail.com

# ── App ───────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
# In production: APP_URL=https://your-app.onrender.com

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
# In production add your domain:
# CORS_ORIGINS=https://your-app.onrender.com,http://localhost:8000

# ── Environment ───────────────────────────────────────────────────
ENVIRONMENT=development

# ── Ports ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
